#!/usr/bin/env bash
# Client for the klause lab server. LAB_URL defaults to http://<LAB_HOST>:8420, LAB_HOST to 192.168.50.104.
#   lab submit <name> <ref> <commands-file> [timeout-sec] [parallel] [priority]   one shell command per line;
#                                                            blank and # lines skipped; higher priority runs first
#   lab parallel <id> <n>                                    let a job run n commands at once, also while it runs
#   lab priority <id> <n>                                    reorder a queued job; a running one yields to a higher one
#   lab pause <id> | lab resume <id>                         hold a job; a running one stops between its commands
#   lab wait <id>...                                         block until every job given has ended; prints each end
#   lab schedule <name> <ref> <commands-file> <interval-sec> [parallel] [priority]   rerun on every new commit of <ref>
#   lab schedules | lab unschedule <id>
#   lab ls | lab show <id> | lab cancel <id> | lab tail <id> <n> [out|err]
#   lab fetch <id> [dest]                                    download the job's output directory over HTTP
#   lab corpus                                               rsync the local bench corpus to the server
set -euo pipefail
host="${LAB_HOST:-192.168.50.104}"
url="${LAB_URL:-http://$host:8420}"
data="${LAB_REMOTE_DATA:-klause-lab-data}"
corpus="${LAB_CORPUS:-$HOME/.cache/klause-bench/corpus}"
cmd="${1:-ls}"; shift || true
case "$cmd" in
submit)
  name="$1" ref="$2" file="$3" timeout="${4:-}" parallel="${5:-1}" priority="${6:-0}"
  jq -n --arg name "$name" --arg ref "$ref" --arg timeout "$timeout" --argjson parallel "$parallel" \
    --argjson priority "$priority" --rawfile body "$file" '{
      name: $name, ref: $ref, parallel: $parallel, priority: $priority,
      commands: [$body | split("\n")[] | select(test("^\\s*(#|$)") | not)
                 | {cmd: .} + (if $timeout == "" then {} else {timeoutSec: ($timeout | tonumber)} end)]
    }' | curl -fsS -H 'Content-Type: application/json' --data-binary @- "$url/jobs"; echo ;;
ls) curl -fsS "$url/jobs?limit=${1:-30}" | jq -r '.[] | [.id, .status,
      "\(.commands | map(select(.status=="DONE" or .status=="FAILED")) | length)/\(.commands | length)",
      "\(.commands | map(select(.status=="FAILED")) | length) failed", "x\(.parallel // 1)",
      "p\(.priority // 0)\(if .paused then " paused" else "" end)", .ref, .name] | @tsv' ;;
show) curl -fsS "$url/jobs/$1" | jq . ;;
cancel) curl -sS -X POST "$url/jobs/$1/cancel"; echo ;;
parallel) jq -n --argjson parallel "$2" '{parallel: $parallel}' |
  curl -sS -H 'Content-Type: application/json' --data-binary @- "$url/jobs/$1/parallel"; echo ;;
priority) jq -n --argjson priority "$2" '{priority: $priority}' |
  curl -sS -H 'Content-Type: application/json' --data-binary @- "$url/jobs/$1/priority"; echo ;;
wait)
  for id in "$@"; do
    while :; do
      # The server holds the request until the job ends; a dropped connection is simply retried.
      status=$(curl -fsS --max-time 660 "$url/jobs/$id/wait?timeoutSec=600" | jq -r .status) || { sleep 10; continue; }
      case "$status" in DONE | FAILED | CANCELLED) echo -e "$id\t$status"; break ;; esac
    done
  done ;;
schedule)
  jq -n --arg name "$1" --arg ref "$2" --argjson interval "$4" --argjson parallel "${5:-1}" --argjson priority "${6:-0}" \
    --rawfile body "$3" '{
      name: $name, ref: $ref, intervalSec: $interval, parallel: $parallel, priority: $priority,
      commands: [$body | split("\n")[] | select(test("^\\s*(#|$)") | not) | {cmd: .}]
    }' | curl -fsS -H 'Content-Type: application/json' --data-binary @- "$url/schedules"; echo ;;
schedules) curl -fsS "$url/schedules" | jq -r '.[] | [.id, .name, .ref, "every \(.intervalSec)s", "p\(.priority)",
      "last \(.lastSha // "-" | .[0:9]) job \(.lastJob // "-")"] | @tsv' ;;
unschedule) curl -sS -X POST "$url/schedules/$1/delete"; echo ;;
pause) curl -sS -X POST "$url/jobs/$1/pause"; echo ;;
resume) curl -sS -X POST "$url/jobs/$1/resume"; echo ;;
tail) curl -fsS "$url/jobs/$1/files/$2.${3:-out}?tail=${TAIL_BYTES:-8000}" ;;
fetch)
  dest="${2:-lab-jobs/$1}"; mkdir -p "$dest"
  curl -fsS "$url/jobs/$1/files" | jq -r '.[] | "\(.path)\t\(.bytes)"' | while IFS=$'\t' read -r path bytes; do
    [[ -f "$dest/$path" && "$(wc -c < "$dest/$path")" -eq "$bytes" ]] && continue
    mkdir -p "$dest/$(dirname "$path")"
    curl -fsS -o "$dest/$path" "$url/jobs/$1/files/$path"
  done ;;
corpus) rsync -az --info=progress2 "$corpus/" "$host:.cache/klause-bench/corpus/" ;;
health) curl -fsS "$url/health" | jq . ;;
*) sed -n '2,9p' "$0"; exit 2 ;;
esac
