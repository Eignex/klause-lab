# Copied to ~/.config/klause-lab/lab.env by install.sh, which writes these settings into both services; rerun it
# after a change. Every setting has a default. Quote values that contain spaces; keep comments on their own lines.

# The JDK the services and klause builds run on. Default: the JDK 25 the Gradle toolchain provisions.
#JAVA_HOME=/path/to/jdk-25
# Default: ~/klause-lab-data
#LAB_DATA=/path/to/klause-lab-data
#LAB_REPO=https://github.com/Eignex/klause.git
# Default: ~/.cache/klause-bench/corpus
#LAB_CORPUS=/path/to/corpus
#LAB_PORT=8420
#LAB_GRADLE_WORKERS=2
#LAB_SOLVE_JAVA_OPTS="-Xmx4g -XX:ActiveProcessorCount=1 -XX:+UseSerialGC"
# The most commands one job may run at once.
#LAB_MAX_PARALLEL=4
# Worktree directories every job shares, separated by ':'. The default keeps bench results across jobs.
#LAB_SHARED_PATHS=klause-bench/build/bench-cache
# Worktree paths copied into the job directory, under collected/, when a job ends.
#LAB_COLLECT_PATHS=klause-bench/output:klause-bench/reference
# The runner holds the queue while the data directory's disk has less than this many GB free.
#LAB_MIN_FREE_GB=10
# Docker for the containerised reference solvers: colima (macOS), system (Linux) or none.
# Default: colima when installed on macOS, system when docker is installed on Linux, else none.
#LAB_DOCKER=colima
# Directories put in front of the services' fixed PATH.
#LAB_PATH=/opt/minizinc/bin
