# Copied to ~/.config/klause-lab/lab.env by install.sh; both services read it.
JAVA_HOME=/path/to/jdk-25
LAB_DATA=/path/to/klause-lab-data
LAB_REPO=git@github.com:Eignex/klause.git
LAB_CORPUS=/path/to/.cache/klause-bench/corpus
LAB_PORT=8420
LAB_GRADLE_WORKERS=2
LAB_SOLVE_JAVA_OPTS=-Xmx4g -XX:ActiveProcessorCount=1 -XX:+UseSerialGC
